<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net$(GuiSystemDialogsNetVersion)-windows$(GuiSystemDialogsWindowsSdkVersion)</TargetFramework>
    <TargetPlatformMinVersion>$(GuiSystemDialogsWindowsMinVersion)</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>$(GuiSystemDialogsWindowsMinVersion)</SupportedOSPlatformVersion>
    <RootNamespace>Gui.SystemDialogs.WinUI.Sharp</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>WinUI 3 / Windows App SDK implementation of Gui.SystemDialogs.Sharp services.</Description>
    <PackageTags>$(PackageTags);winui;windows-app-sdk</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gui.SystemDialogs.Sharp\Gui.SystemDialogs.Sharp.csproj" />
    <ProjectReference Include="..\Gui.SystemDialogs.Windows.Sharp\Gui.SystemDialogs.Windows.Sharp.csproj" />
  </ItemGroup>

</Project>
