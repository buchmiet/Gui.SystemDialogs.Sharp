<Project>
  <PropertyGroup>
    <!-- Change this single value when upgrading the whole repository. -->
    <GuiSystemDialogsNetVersion>10.0</GuiSystemDialogsNetVersion>

    <!-- Shared Windows API contract for WinUI, WPF and Windows-only MAUI. -->
    <GuiSystemDialogsWindowsSdkVersion>10.0.19041.0</GuiSystemDialogsWindowsSdkVersion>
    <GuiSystemDialogsWindowsMinVersion>10.0.17763.0</GuiSystemDialogsWindowsMinVersion>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      The package version comes from the nearest reachable git tag, via MinVer. There is deliberately
      no <Version> property: the tag is the single source of truth, so the repository and NuGet.org can
      never disagree about what a given commit published. Tags are prefixed with "v" (v0.1.0), which is
      not MinVer's default, hence MinVerTagPrefix below.

      A build on an untagged commit yields a prerelease such as 0.1.1-alpha.0.3. That is correct and
      expected: only a tagged commit produces a release version.
    -->
    <MinVerTagPrefix>v</MinVerTagPrefix>

    <!--
      AssemblyVersion is frozen on purpose: it is the identity used for assembly binding, and keeping
      it stable avoids redirect churn. MinVer honours an explicitly set AssemblyVersion.

      FileVersion and AssemblyInformationalVersion are left to MinVer, which sets them from the tag —
      the informational version also carries the commit hash, so any published binary can be traced
      back to its source. Do not set FileVersion here; MinVer overrides it and the value would be a
      no-op.
    -->
    <AssemblyVersion>0.0.0.0</AssemblyVersion>

    <Authors>Lukasz Buchmiet</Authors>
    <Copyright>Copyright (c) 2026 Lukasz Buchmiet</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/buchmiet/Gui.SystemDialogs.Sharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/buchmiet/Gui.SystemDialogs.Sharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>system-dialogs;file-picker;folder-picker;csharp;dotnet</PackageTags>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      The contracts assembly is the published specification, so a missing XML comment there is a
      build warning that must be fixed rather than suppressed. Adapters implement interfaces that
      are already documented on the contract, so CS1591 stays suppressed for them.
    -->
    <NoWarn Condition="'$(MSBuildProjectName)' != 'Gui.SystemDialogs.Sharp'">$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>

    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
