<Project>
  <PropertyGroup>
    <GuiSystemDialogsNetVersion>10.0</GuiSystemDialogsNetVersion>
    <GuiSystemDialogsWindowsSdkVersion>10.0.19041.0</GuiSystemDialogsWindowsSdkVersion>
    <GuiSystemDialogsWindowsMinVersion>10.0.17763.0</GuiSystemDialogsWindowsMinVersion>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
