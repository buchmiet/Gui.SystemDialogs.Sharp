      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Gui.SystemDialogs.Maui.Sharp\Gui.SystemDialogs.Maui.Sharp.csproj" />
    <ProjectReference Include="..\..\Gui.SystemDialogs.Sharp\Gui.SystemDialogs.Sharp.csproj" />
    <ProjectReference Include="..\..\Gui.SystemDialogs.Windows.Sharp\Gui.SystemDialogs.Windows.Sharp.csproj" />
    <ProjectReference Include="..\Gui.SystemDialogs.TestSupport\Gui.SystemDialogs.TestSupport.csproj" />
  </ItemGroup>
